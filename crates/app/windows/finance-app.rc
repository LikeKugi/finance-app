#pragma code_page(65001)
1 ICON "@ICON_PATH@"

1 VERSIONINFO
FILEVERSION @FILE_VERSION@
PRODUCTVERSION @FILE_VERSION@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "FileDescription", "FinanceApp"
      VALUE "ProductName", "FinanceApp"
      VALUE "OriginalFilename", "finance-app.exe"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0419, 1200
  END
END
